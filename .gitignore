# ------------------------------------------------------------------
# UN64 — never commit original game data or decompilation output.
#
# This is an ALLOW-LIST: everything at the top level is ignored except
# the patcher's own files below. Per-game decompile folders (sm64/, oot/,
# bk/, ...), Assets/ (ROM dumps), tools/, widescreen/ and anything added
# later stay out automatically.
# ------------------------------------------------------------------

/*
!/.gitignore
!/.github/
!/src/
!/README.md
!/LICENSE
!/Supported Games.txt
!/UN64 Patcher.exe

# ---- Even inside allowed folders, never commit game data ----

# N64 ROM images (original or patched), disk images, archives
*.z64
*.Z64
*.n64
*.N64
*.v64
*.V64
*.rom
*.ROM
*.ndd
*.d64
*.zip
*.7z
*.rar

# Firmware / raw binaries / build objects
*.bin
*.elf
*.o
*.ld
*.map

# Save data / emulator state
*.eep
*.sra
*.fla
*.mpk
*.st[0-9]
*.state

# Disassembly output
*.s
*.asm

# Build output inside src
src/*.exe

# OS / editor clutter
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
